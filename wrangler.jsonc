{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weiyu",
  "main": "dist/server/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "routes": [{ "pattern": "weiyu.bool.win", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weiyu-demo",
      "database_id": "1ceb3b85-4a54-4c95-9cb0-5da9318d63a3",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
}
